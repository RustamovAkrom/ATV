ENV=test
APP_NAME=fastapibackend
APP_VERSION=1.0.0
APP_DESCRIPTION=production ready fastapi backend

APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
ROOT_PATH=

SECRET_KEY=test-secret-key-with-sufficient-length-12345

POSTGRES_HOST=localhost
POSTGRES_PORT=25439
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test_db
POSTGRES_ECHO=false

REDIS_URL=redis://redis:6379/1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_FROM=test@example.com

RATE_LIMIT_ENABLED=false

LOG_INCLUDE_REQUEST_ID=false
LOG_LEVEL=WARNING
